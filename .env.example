# Puerto del servidor. En Railway lo inyecta la plataforma.
PORT=3000

# Base de datos de desarrollo.
DATABASE_URL=postgres://usuario:contraseña@localhost:5432/jetty

# Base de datos para los tests. Su nombre DEBE terminar en "_test":
# los tests la vacían por completo en cada corrida.
# Si se deja vacía, los tests que necesitan base se saltean.
DATABASE_URL_TEST=postgres://usuario:contraseña@localhost:5432/jettywallet_test

# Orígenes permitidos por CORS (separados por coma si son varios).
FRONTEND_URL=http://localhost:5173

# Clave para firmar los tokens de sesión. Usar una cadena larga y aleatoria.
JWT_SECRET=
CURRENCY_FREAKS_API_KEY=
FIXER_API_KEY=
